{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tuning-sim",
  "mainBinaryName": "tuning-sim",
  "version": "0.1.0",
  "identifier": "io.github.devmca.tuningsim",
  "build": {
    "beforeDevCommand": "sh scripts/prepare-ui.sh dev",
    "beforeBuildCommand": "sh scripts/prepare-ui.sh build",
    "devUrl": "http://localhost:5180",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tuning-sim",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:5180"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "Education",
    "shortDescription": "Engine tuning simulator",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "externalBin": ["binaries/simcore"],
    "resources": {
      "../../shared/engines/": "shared/engines/",
      "../../shared/tables/": "shared/tables/"
    }
  }
}
